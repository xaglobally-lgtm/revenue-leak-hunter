# Optional runtime settings for Revenue Leak Hunter.
# All values are optional and unset by default — the app works with
# zero configuration (in-memory demo database, port 3000).
# Copy this file to `.env` if you want to override anything locally.

# PORT: TCP port the web server listens on.
# Hosting like Render (free tier) sets this automatically — ignore locally
# unless port 3000 is already in use.
# PORT=4000

# NODE_ENV: set to "production" (or just run `npm run build` then
# `npm run start`) to serve the built app from dist/.
# Omit it for plain `npm run dev` (Vite dev server + auto-reload).
# NODE_ENV=production

# Supabase (optional, later — step 3 of DEPLOYMENT.md): real persistence
# so data survives server restarts. Used server-side only.
# SUPABASE_URL=YOUR_PROJECT_URL
# SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Supabase Auth (optional): real user login (magic-link email sign-in)
# instead of the shared demo session. These two MUST be prefixed with
# VITE_ because they are read by the browser at build time — they are the
# same Project URL / anon key as above, just re-exposed to the frontend.
# Safe to make public: the anon key alone cannot read or write your data.
# Leave unset to keep the app in demo mode (matches SUPABASE_URL/SUPABASE_ANON_KEY).
# VITE_SUPABASE_URL=YOUR_PROJECT_URL
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# RLH_STORE_FILE (optional): durable local storage with ZERO setup.
# Set a JSON file path and every change (recoveries, payments, settings,
# audit log) is saved and restored across restarts, instead of resetting to
# the demo fixture. Good for running demos and bookkeeping before Supabase.
# RLH_STORE_FILE=data/rlh-data.json

# Resend (optional): forwards Contact form submissions to a real inbox by
# email instead of only logging them to the audit log. Get a free API key at
# https://resend.com (sign in with Google — no credit card, no domain needed
# to send to your own verified account email). Leave unset and the contact
# form keeps working exactly as before (received + logged, just not emailed).
# RESEND_API_KEY=re_your_key_here

# CONTACT_NOTIFICATION_EMAIL (optional): where contact-form submissions are
# sent when RESEND_API_KEY is set. Defaults to the account email if unset.
# CONTACT_NOTIFICATION_EMAIL=you@example.com