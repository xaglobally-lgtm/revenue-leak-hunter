# Revenue Leak Hunter — Environment Configuration
# Copy this file to .env (in the root folder, same level as package.json)
# Replace the placeholder values with your actual credentials

# Server Port
# Default: 3000. Change to avoid conflicts (e.g., 3002 if 3000 is in use)
PORT=3002

# Supabase Persistence (OPTIONAL)
# If omitted, the app runs in in-memory demo mode (data resets on restart).
# To enable persistent storage:
#   1. Create a Supabase account (supabase.com)
#   2. Follow SUPABASE_SETUP_GUIDE.md
#   3. Copy your Project URL and anon key below

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# File-based Persistence (ALTERNATIVE - see DEPLOYMENT.md)
# If you prefer to store data in a local JSON file instead of Supabase,
# uncomment this line. The file will be created/updated automatically.
# Warning: This does NOT work on Render (free tier) because Render restarts daily.
# RLH_STORE_FILE=data/rlh-data.json
